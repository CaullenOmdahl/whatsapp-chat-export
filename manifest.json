{
  "manifest_version": 3,
  "name": "Chat Export for WhatsApp",
  "version": "1.0.3",
  "description": "Export a WhatsApp Web conversation to clean HTML, TXT, JSON or CSV, with optional media. Everything stays on your device.",
  "minimum_chrome_version": "102",
  "permissions": [
    "storage",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "action": {
    "default_title": "Export this WhatsApp chat",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "src/lib/namespace.js",
        "src/lib/datetime.js",
        "src/lib/zip.js",
        "src/lib/formats.js",
        "src/content/extractor.js",
        "src/content/media.js",
        "src/content/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
